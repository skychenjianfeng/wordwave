[{"id":1,"freq":1,"word":"Array.from()","meaning":"Array.from() 方法从一个类似数组或可迭代对象中创建一个新的数组实例。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":2,"freq":2,"word":"Array.isArray()","meaning":"Array.isArray() 用于确定传递的值是否是一个 Array。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":3,"freq":3,"word":"Array.observe()","meaning":"Array.observe() 方法用于异步监视数组发生的变化，类似于针对对象的 Object.observe() 。当数组的值发生变化时，它按发生顺序提供了一个变化流。与 Object.observe() 类似，它由如下可接受的变化类型列表['add'、'update'、'delete'、'splice']触发。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":4,"freq":4,"word":"Array.of()","meaning":"Array.of() 方法创建一个具有可变数量参数的新数组实例，而不考虑参数的数量或类型。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":5,"freq":5,"word":"concat()","meaning":"concat() 方法用于合并两个或多个数组。此方法不会更改现有数组，而是返回一个新数组。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":6,"freq":6,"word":"copyWithin()","meaning":"改变了的数组。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":7,"freq":7,"word":"entries()","meaning":"entries() 方法返回一个新的Array Iterator对象，该对象包含数组中每个索引的键/值对。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":8,"freq":8,"word":"every()","meaning":"every() 方法测试数组的所有元素是否都通过了指定函数的测试。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":9,"freq":9,"word":"fill()","meaning":"fill() 方法用一个固定值填充一个数组中从起始索引到终止索引内的全部元素。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":10,"freq":10,"word":"filter()","meaning":"filter() 方法创建一个新数组, 其包含通过所提供函数实现的测试的所有元素。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":11,"freq":11,"word":"find()","meaning":"find() 方法返回数组中满足提供的测试函数的第一个元素的值。否则返回 undefined。","alt":null,"category":"专业领域","subcategory":"JavaScript API","ipa":null},{"id":12,"freq":12,"word":"findIndex()","meaning":"findIndex()方法返回数组中满足提供的测试函数的第一个元素的索引。否则返回-1。","alt":null,"ca