# 复制为 server/.env.django 并修改（不含任何真实密钥；DeepSeek 密钥仍在 server/.env）
DJANGO_SECRET_KEY=please-generate-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL=true

MYSQL_DATABASE=wordwave
MYSQL_USER=wordwave
MYSQL_PASSWORD=wordwave_dev_password
MYSQL_HOST=localhost
MYSQL_PORT=13307

REDIS_HOST=localhost
REDIS_PORT=16380
